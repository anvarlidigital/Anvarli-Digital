rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Public catalog collections
    match /services/{serviceId} {
      allow read: if true;
      allow write: if true;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if true;
    }

    match /staff/{staffId} {
      allow read: if true;
      allow write: if true;
    }

    match /salaryPayments/{paymentId} {
      allow read, write: if true;
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    match /slotUsage/{slotUsageId} {
      allow read: if true;
      allow write: if true;
    }

    match /waitlist/{waitlistId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    match /adminAuth/{authId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
